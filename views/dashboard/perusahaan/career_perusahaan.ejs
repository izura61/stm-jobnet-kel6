<%- include('partials/header', { currentPage: 'career', title: 'Post Job - STM JOB' }) %>

<main class="max-w-4xl mx-auto px-6 py-12 pb-28 md:pb-12">
    <div class="mb-10 text-center">
        <span class="inline-block px-4 py-1.5 bg-[#7f97d9]/10 text-[#7f97d9] text-[10px] font-black uppercase tracking-[0.3em] rounded-full mb-4">
            Talent Acquisition
        </span>
        <h1 class="text-3xl md:text-4xl font-black text-slate-800 tracking-tight">Posting Lowongan Baru</h1>
        <p class="text-slate-500 mt-3 text-base md:text-lg">Halo <%= user.name.split(' ')[0] %>, lengkapi detail pekerjaan untuk mendapatkan kandidat terbaik.</p>
    </div>

    <form action="/api/lowongan/create" method="POST" class="bg-white p-8 md:p-16 rounded-[2.5rem] md:rounded-[3.5rem] border border-slate-100 shadow-sm relative overflow-hidden">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10 relative z-10">
            <div class="md:col-span-2">
                <label class="block text-[10px] md:text-[11px] font-black text-slate-400 uppercase tracking-widest mb-3 md:mb-4 ml-2">Judul Posisi Pekerjaan</label>
                <input type="text" name="judul" placeholder="Contoh: Junior Web Developer" required
                    class="w-full px-6 md:px-8 py-4 md:py-5 bg-slate-50 border border-slate-100 rounded-[1.5rem] md:rounded-[2rem] focus:ring-4 focus:ring-[#7f97d9]/10 focus:border-[#7f97d9] outline-none transition-all font-bold text-slate-700 placeholder:text-slate-300 text-sm md:text-base">
            </div>

            <div>
                <label class="block text-[10px] md:text-[11px] font-black text-slate-400 uppercase tracking-widest mb-3 md:mb-4 ml-2">Tipe Program</label>
                <div class="relative">
                    <select name="tipe" required class="w-full px-6 md:px-8 py-4 md:py-5 bg-slate-50 border border-slate-100 rounded-[1.5rem] md:rounded-[2rem] focus:ring-4 focus:ring-[#7f97d9]/10 focus:border-[#7f97d9] outline-none font-bold text-slate-700 appearance-none cursor-pointer text-sm md:text-base">
                        <option value="" disabled selected>Pilih Tipe</option>
                        <option value="PKL">Praktik Kerja Lapangan (PKL)</option>
                        <option value="Magang">Magang Industri</option>
                        <option value="Kerja">Lulusan Baru (Full-time)</option>
                    </select>
                    <div class="absolute right-6 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-[10px] md:text-[11px] font-black text-slate-400 uppercase tracking-widest mb-3 md:mb-4 ml-2">Lokasi Penempatan</label>
                <input type="text" name="lokasi" placeholder="Contoh: Cimahi, Jawa Barat" required
                    class="w-full px-6 md:px-8 py-4 md:py-5 bg-slate-50 border border-slate-100 rounded-[1.5rem] md:rounded-[2rem] focus:ring-4 focus:ring-[#7f97d9]/10 focus:border-[#7f97d9] outline-none font-bold text-slate-700 text-sm md:text-base">
            </div>

            <div class="md:col-span-2">
                <label class="block text-[10px] md:text-[11px] font-black text-slate-400 uppercase tracking-widest mb-3 md:mb-4 ml-2">Estimasi Gaji (Opsional)</label>
                <input type="text" name="gaji" placeholder="Contoh: Rp 2.000.000 - Rp 4.000.000"
                    class="w-full px-6 md:px-8 py-4 md:py-5 bg-slate-50 border border-slate-100 rounded-[1.5rem] md:rounded-[2rem] focus:ring-4 focus:ring-[#7f97d9]/10 focus:border-[#7f97d9] outline-none font-bold text-slate-700 text-sm md:text-base">
            </div>

            <div class="md:col-span-2">
                <label class="block text-[10px] md:text-[11px] font-black text-slate-400 uppercase tracking-widest mb-3 md:mb-4 ml-2">Deskripsi Pekerjaan</label>
                <textarea name="deskripsi" rows="5" placeholder="Tuliskan poin-poin tanggung jawab..." required
                    class="w-full px-6 md:px-8 py-5 md:py-6 bg-slate-50 border border-slate-100 rounded-[2rem] md:rounded-[2.5rem] focus:ring-4 focus:ring-[#7f97d9]/10 focus:border-[#7f97d9] outline-none transition-all font-medium text-slate-600 text-sm md:text-base"></textarea>
            </div>

            <div class="md:col-span-2">
                <label class="block text-[10px] md:text-[11px] font-black text-slate-400 uppercase tracking-widest mb-3 md:mb-4 ml-2">Kualifikasi Khusus</label>
                <textarea name="kualifikasi" rows="5" placeholder="Contoh: Menguasai Javascript..." required
                    class="w-full px-6 md:px-8 py-5 md:py-6 bg-slate-50 border border-slate-100 rounded-[2rem] md:rounded-[2.5rem] focus:ring-4 focus:ring-[#7f97d9]/10 focus:border-[#7f97d9] outline-none transition-all font-medium text-slate-600 text-sm md:text-base"></textarea>
            </div>
        </div>

        <div class="mt-10 md:mt-16 flex flex-col sm:flex-row gap-4 md:gap-5 relative z-10">
            <button type="submit" class="w-full sm:flex-[2] px-6 md:px-10 py-5 md:py-6 bg-slate-900 text-white rounded-[1.5rem] md:rounded-[2rem] text-[10px] md:text-xs font-black uppercase tracking-[0.2em] shadow-xl md:shadow-2xl hover:bg-[#7f97d9] transition-all active:scale-95 text-center">
                Tayangkan Lowongan
            </button>
            <a href="/dashboard/perusahaan" class="w-full sm:flex-1 px-6 md:px-10 py-5 md:py-6 bg-slate-100 text-slate-400 rounded-[1.5rem] md:rounded-[2rem] text-[10px] md:text-xs font-black uppercase tracking-[0.2em] hover:bg-slate-200 transition-all flex items-center justify-center text-center">
                Batalkan
            </a>
        </div>
    </form>
</main>

<nav class="md:hidden fixed bottom-0 left-0 w-full bg-white border-t border-slate-200 z-50 shadow-[0_-4px_10px_rgba(0,0,0,0.05)]">
    <ul class="flex justify-between items-center py-2 px-1 text-[9px] sm:text-[10px] font-bold text-slate-500 uppercase tracking-wider">
        <li class="flex-1">
            <a href="/dashboard/perusahaan" class="flex flex-col items-center gap-1 hover:text-[#7f97d9] transition text-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span>Home</span>
            </a>
        </li>
        <li class="flex-1">
            <a href="/career-perusahaan" class="flex flex-col items-center gap-1 text-[#7f97d9] transition text-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span>Posting</span>
            </a>
        </li>
        <li class="flex-1">
            <a href="/kelola-loker" class="flex flex-col items-center gap-1 hover:text-[#7f97d9] transition text-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                <span>Pelamar</span>
            </a>
        </li>
        <li class="flex-1">
            <a href="/dashboard/perusahaan/help" class="flex flex-col items-center gap-1 hover:text-[#7f97d9] transition text-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Help</span>
            </a>
        </li>
    </ul>
</nav>

<%- include('partials/footer') %>