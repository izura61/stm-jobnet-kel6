<%- include('partials/header', { currentPage: 'dashboard', title: 'Dashboard Perusahaan' }) %>

<main class="max-w-7xl mx-auto px-6 py-12 pb-28 md:pb-12">
    
    <div class="bg-white p-8 md:p-16 rounded-[2.5rem] md:rounded-[3rem] border border-slate-100 shadow-sm mb-12 relative overflow-hidden">
        <div class="relative z-10 max-w-2xl">
            <span class="inline-block px-4 py-1.5 bg-[#7f97d9]/10 text-[#7f97d9] text-[10px] font-black uppercase tracking-[0.3em] rounded-full mb-4">
                Partner Dashboard
            </span>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-800 leading-tight">
                Halo, <span class="text-[#7f97d9]"><%= user.name.split(' ')[0] %></span>!
            </h1>
            <p class="text-slate-500 mt-4 text-base sm:text-lg md:text-xl leading-relaxed">
                Kelola lowongan pekerjaan dan temukan calon tenaga kerja terbaik dari SMK Negeri 1 Cimahi secara efisien.
            </p>
            
            <div class="mt-8 flex flex-col sm:flex-row gap-4 w-full">
                <a href="/career-perusahaan" class="w-full sm:w-auto text-center px-8 py-4 bg-slate-900 text-white rounded-2xl text-[11px] sm:text-xs font-black uppercase tracking-widest shadow-xl hover:bg-[#7f97d9] transition-all active:scale-95">
                    Posting Lowongan Baru
                </a>
                <a href="/kelola-loker" class="w-full sm:w-auto text-center px-8 py-4 bg-white border-2 border-slate-100 text-slate-600 rounded-2xl text-[11px] sm:text-xs font-black uppercase tracking-widest hover:bg-slate-50 hover:border-slate-200 transition-all">
                    Manajemen Pelamar
                </a>
            </div>
        </div>
        <div class="absolute right-[-15%] bottom-[-10%] md:right-[-5%] w-60 md:w-80 h-60 md:h-80 bg-[#7f97d9]/10 md:bg-[#7f97d9]/5 rounded-full blur-3xl"></div>
    </div>

    <h2 class="text-xs font-black text-slate-400 uppercase tracking-[0.4em] mb-8 flex items-center gap-3">
        <span class="w-12 h-[3px] bg-[#7f97d9] rounded-full"></span> Performance Overview
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-16">
        <div class="bg-white border border-slate-100 p-8 rounded-[2.5rem] md:rounded-[3rem] shadow-sm relative overflow-hidden group hover:border-[#7f97d9] transition-all">
            <div class="absolute top-0 right-0 w-24 h-24 bg-[#7f97d9]/5 rounded-bl-[3rem] -mr-4 -mt-4 transition-all group-hover:scale-110"></div>
            <p class="text-slate-400 text-[10px] font-black uppercase tracking-widest mb-2">Total Postingan</p>
            <h3 class="text-4xl md:text-5xl font-black text-slate-800 tracking-tighter">
                <%= stats.totalLoker %>
            </h3>
        </div>

        <div class="bg-white border border-slate-100 p-8 rounded-[2.5rem] md:rounded-[3rem] shadow-sm relative overflow-hidden group hover:border-emerald-200 transition-all">
            <div class="absolute top-0 right-0 w-24 h-24 bg-emerald-50 rounded-bl-[3rem] -mr-4 -mt-4 transition-all group-hover:scale-110"></div>
            <p class="text-slate-400 text-[10px] font-black uppercase tracking-widest mb-2">Pelamar Masuk</p>
            <h3 class="text-4xl md:text-5xl font-black text-slate-800 tracking-tighter">
                <%= stats.totalPelamar %>
            </h3>
        </div>

        <div class="bg-white border border-slate-100 p-8 rounded-[2.5rem] md:rounded-[3rem] shadow-sm relative overflow-hidden group hover:border-amber-200 transition-all">
            <div class="absolute top-0 right-0 w-24 h-24 bg-amber-50 rounded-bl-[3rem] -mr-4 -mt-4 transition-all group-hover:scale-110"></div>
            <p class="text-slate-400 text-[10px] font-black uppercase tracking-widest mb-2">Lowongan Aktif</p>
            <h3 class="text-4xl md:text-5xl font-black text-slate-800 tracking-tighter">
                <%= stats.lokerAktif %>
            </h3>
        </div>
    </div>

    <div class="bg-slate-900 rounded-[2.5rem] md:rounded-[3rem] p-8 md:p-14 text-white relative overflow-hidden shadow-2xl shadow-slate-200 mb-16">
        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6 md:gap-8">
            <div class="max-w-xl">
                <h4 class="text-xl md:text-2xl font-bold mb-3">Butuh Bantuan Navigasi?</h4>
                <p class="text-slate-400 text-sm md:text-base leading-relaxed">
                    Kami menyediakan panduan lengkap untuk memudahkan Anda mengelola akun industri, mulai dari pembuatan lowongan hingga proses seleksi pelamar.
                </p>
            </div>
            <a href="/dashboard/perusahaan/guide_book" class="inline-flex items-center justify-center px-6 md:px-8 py-4 bg-[#7f97d9] text-white rounded-2xl text-[10px] md:text-xs font-black uppercase tracking-widest hover:bg-white hover:text-[#7f97d9] transition-all group text-center w-full md:w-auto">
                Buka Panduan Utama <span class="ml-2 transition-transform group-hover:translate-x-2">→</span>
            </a>
        </div>
        <div class="absolute top-0 right-0 w-full md:w-1/2 h-full bg-gradient-to-t md:bg-gradient-to-l from-white/5 to-transparent"></div>
    </div>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        <div class="bg-white border border-slate-100 p-8 md:p-10 rounded-[2.5rem] md:rounded-[3rem] shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-6">
            <div class="w-14 h-14 md:w-16 md:h-16 bg-blue-50 text-blue-500 rounded-2xl flex items-center justify-center text-2xl md:text-3xl flex-shrink-0">🛡️</div>
            <div>
                <h5 class="font-bold text-slate-800 text-lg">Keamanan Akun</h5>
                <p class="text-slate-400 text-sm mt-1 mb-2">Pastikan data perusahaan Anda valid untuk menjaga kredibilitas di mata pelamar.</p>
                <a href="/perusahaan/profil" class="text-[#7f97d9] text-[11px] md:text-xs font-bold inline-block uppercase tracking-wider">Update Profil →</a>
            </div>
        </div>
        <div class="bg-white border border-slate-100 p-8 md:p-10 rounded-[2.5rem] md:rounded-[3rem] shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-6">
            <div class="w-14 h-14 md:w-16 md:h-16 bg-purple-50 text-purple-500 rounded-2xl flex items-center justify-center text-2xl md:text-3xl flex-shrink-0">⚙️</div>
            <div>
                <h5 class="font-bold text-slate-800 text-lg">Pusat Bantuan</h5>
                <p class="text-slate-400 text-sm mt-1 mb-2">Punya kendala teknis? Tim support kami siap membantu operasional dashboard Anda.</p>
                <a href="/dashboard/perusahaan/help" class="text-[#7f97d9] text-[11px] md:text-xs font-bold inline-block uppercase tracking-wider">Hubungi Support →</a>
            </div>
        </div>
    </section>

</main>

